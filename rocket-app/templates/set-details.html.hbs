    <header class="modal-header"><div><p class="eyebrow">{{code}} · SET DETAILS</p><h2 id="dialog-title">{{#if name}}{{name}}{{else}}Unknown set{{/if}}</h2><div class="dialog-progress">{{> progress}}</div></div><button class="icon-button" data-close aria-label="Close set details">✕</button></header>
    {{#if available}}<section class="card-toolbar" aria-label="Find cards">
      <label class="search-field" for="card-search"><span class="sr-only">Search cards</span><input type="search" id="card-search" placeholder="Card name or collector number…" maxlength="200" aria-controls="card-list" /></label>
      <div class="card-options"><div class="segmented" role="group" aria-label="Card ownership filter"><button type="button" data-card-filter="all" aria-pressed="true">All</button><button type="button" data-card-filter="missing" aria-pressed="false">Missing</button><button type="button" data-card-filter="collected" aria-pressed="false">Collected</button></div><div class="segmented view-switch" role="group" aria-label="Card display"><button type="button" data-card-view="grid" aria-pressed="true">Grid</button><button type="button" data-card-view="list" aria-pressed="false">Checklist</button></div></div>
      <label class="printing-control" for="card-kind"><span>Printings</span><select id="card-kind" aria-controls="card-list"><option value="all">All printings</option><option value="base">Base</option><option value="variant">Variants</option><option value="unclassified">Unclassified</option></select></label>
      <p class="result-count" id="card-results" role="status" aria-live="polite">{{set_count}} cards</p>
    </section>{{/if}}
    <div class="modal-body">
      {{#if available}}<ul class="card-grid" id="card-list">
        {{#each cards}}<li class="card-item" data-kind="{{printing_kind}}" data-card-name="{{name}}" data-card-number="{{collector_number}}" data-collected="{{#if collected}}true{{else}}false{{/if}}">{{#if scryfall_id}}<a class="card-link" href="https://scryfall.com/card/{{scryfall_id}}" target="_blank" rel="noopener noreferrer" title="View {{name}} on Scryfall (opens in a new tab)">{{/if}}<figure><div class="card-art">{{#if image}}<img loading="lazy" width="146" height="204" src="{{image}}" alt="{{name}}" />{{else}}<div class="art-placeholder">Artwork unavailable</div>{{/if}}<span class="badge {{#if collected}}collected{{else}}missing{{/if}}">{{#if collected}}✓ Collected{{else}}Missing{{/if}}</span></div><figcaption><span class="collector-number">#{{collector_number}}</span><span class="card-name">{{name}}<span class="printing-label {{printing_kind}}">{{printing_kind}}</span></span></figcaption></figure>{{#if scryfall_id}}</a>{{/if}}</li>{{/each}}
      </ul><div class="empty-state" id="card-empty" hidden><h3>No matching cards.</h3><p>Try another name, collector number, ownership, or printing filter.</p><button class="button" data-reset-cards>Reset card filters</button></div>{{else}}<div class="empty-state"><h3>This set isn't in our card database yet.</h3><p>Your collection is safe. Completion will be available when we can match its printings.</p></div>{{/if}}
    </div>
